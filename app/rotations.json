  "fews_pk_2026": {
   "title": "FEWS NET, Pakistan Special Report, May 2026 (Figure 3, seasonal crop calendar, source FAO)",
   "url": "https://fews.net/asia/pakistan/special-report/may-2026",
   "read": true,
   "quote": "Kharif planting typically happens between April and July, with the bulk of harvesting from September to November. Wheat is generally planted between October and December, while most harvesting occurs between April and mid-June. Sugarcane has two sowing seasons: spring (February-March) and autumn (September-October); harvesting begins in October and continues until April-May."
  },
